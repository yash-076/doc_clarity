DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/doc_clarity
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
MOCK_USER_ID=00000000-0000-0000-0000-000000000001
ENVIRONMENT=development
LOG_LEVEL=INFO

# Phase 2: OCR Configuration
TESSERACT_CMD=
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_MIN_TEXT_CHARS=50
OCR_DPI=200

# Phase 2: Chunking Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Phase 3: Embedding Model Configuration
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# Phase 3: ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=document_chunks

# Phase 3: Retrieval Configuration
DEFAULT_TOP_K=5
MAX_TOP_K=20

# Phase 4: RAG & LLM Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash,gemini-1.5-pro
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=1000

DEFAULT_RAG_TOP_K=5
MAX_RAG_TOP_K=10
MAX_CONTEXT_CHARS=12000

# Phase 5: Automatic Analysis Settings
ANALYSIS_TOP_K=5
ANALYSIS_MAX_CHUNKS=30
ANALYSIS_MAX_CONTEXT_CHARS=30000
